{
  "routes": [
    {
      "src": "^/((?:wp-admin|wp-includes|wp-content/(?:plugins|themes|mu-plugins))/.+)\\.(css|js|svg|png|gif|jpg|jpeg|webp|woff|woff2|ico|otf)$",
      "headers": {
        "Cache-Control": "max-age=864000, s-maxage=864000"
      },
      "continue": true
    },
    {
      "src": "^/((?:wp-admin|wp-includes|wp-content/(?:plugins|themes|mu-plugins))/.+)\\.(css|js|svg|png|gif|jpg|jpeg|webp|woff|woff2|ico|otf)$",
      "dest": "/wp/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/vercel.js"
    }
  ],
  "functions": {
    "api/vercel.js": {
      "includeFiles": "{wp/**,node_modules/serverlesswp/{wordpress-assets,php-files}/**,node_modules/sqlite3/**}",
      "maxDuration": 60
    }
  },
  "env": {
    "BLOB_STORE_ID": "store_V0zcGEi8t6kE69xe",
    "SERVERLESSWP_STREAM_PROVIDER": "vercel-blob",
    "SERVERLESSWP_STREAM_VERCEL_ACCESS": "private"
  },
  "installCommand": "npm_config_build_from_source=true npm install",
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "public"
}
